###create openssl.cnf

cat > openssl.cnf <<EOF
[req]
distinguished_name = dn
req_extensions = v3_req
prompt = no

[dn]
CN = registry.pronteff.com         #Note- dont use "registry-lab-ca" as CN here

[v3_req]
subjectAltName = @alt_names
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[alt_names]
DNS.1 = registry.pronteff.com
IP.1 = 192.168.18.19
EOF

###create registry.key

openssl genrsa -out registry.key 4096

###use below command to get out registry.csr using registry.key
openssl req -new -key registry.key -out registry.csr -config openssl.cnf

###finally create registry.crt using registry.csr; ca.crt ; ca.key

openssl x509 -req -in registry.csr -CA ca.crt -CAkey ca.key -CAcreateserial -out registry.crt -days 3650 -sha256 -extfile openssl.cnf -extensions v3_req



###verify

openssl x509 -in registry.crt -text -noout | grep -A 2 "Subject Alternative Name"

###We must see the below output

X509v3 Subject Alternative Name:
    DNS:registry.ourdomain.com, IP Address:192.168.18.19
	
	
	
